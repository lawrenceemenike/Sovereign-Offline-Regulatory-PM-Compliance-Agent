# Local LLM & Ollama Configuration (Zero Cloud Exfiltration)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Database Configuration (PostgreSQL in production; SQLite fallback supported)
# PostgreSQL example: postgresql+psycopg2://lexguard:lexguard_sec@localhost:5432/lexguard_db
DATABASE_URL=sqlite:///./lexguard.db

# Vector Storage Directory
VECTOR_STORE_DIR=./backend/data/vector_store

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8005
